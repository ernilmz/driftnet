{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Driftnet",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../../native/windows/installer-hooks.nsh",
        "template": "../../native/windows/installer-template.nsi"
      }
    },
    "resources": {
      "../../licenses/Wintun-LICENSE.txt": "licenses/Wintun-LICENSE.txt",
      "../../native/windows/Tauri-LICENSE-MIT.txt": "licenses/Tauri-NSIS-LICENSE-MIT.txt"
    }
  }
}
