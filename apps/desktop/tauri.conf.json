{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Driftnet",
  "version": "1.0.2",
  "identifier": "app.drift.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:4173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Driftnet",
        "width": 424,
        "height": 248,
        "minWidth": 320,
        "minHeight": 224,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/drift-engine",
      "binaries/drift-agent",
      "binaries/drift-router"
    ],
    "resources": {
      "../../LICENSE": "licenses/Driftnet-LICENSE.txt",
      "../../vendor/byedpi/LICENSE": "licenses/ByeDPI-LICENSE.txt",
      "../../vendor/byedpi/UPSTREAM.json": "licenses/engine-UPSTREAM.json",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../licenses/IBM-Plex-Mono-OFL.txt": "licenses/IBM-Plex-Mono-OFL.txt",
      "../../native/engine/fixes.json": "licenses/engine-fixes.json",
      "../../vendor/sing-box/LICENSE": "licenses/sing-box-LICENSE.txt",
      "../../vendor/sing-box/DRIFT_UPSTREAM.json": "licenses/router-UPSTREAM.json",
      "../../native/router/README.md": "licenses/router-integration.txt",
      "../../vendor/glib/LICENSE": "licenses/GLib-rs-MIT-LICENSE.txt",
      "../../native/patches/glib-0.18.5-variant-str-iter.patch": "licenses/GLib-rs-backport.patch"
    },
    "homepage": "https://github.com/ernilmz/driftnet",
    "copyright": "\u00a9 2026 Driftnet contributors",
    "shortDescription": "Local routing for selected apps and websites.",
    "category": "Utility"
  }
}
