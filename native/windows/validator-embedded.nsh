; Generated from validate-install.ps1. Keep the readable source in sync.
; SHA256: 7c5353276ed34618c924e90b3cbbbba7196f908c53268483280edd42cb478288
!macro DRIFT_WRITE_VALIDATOR
  FileOpen $2 "$PLUGINSDIR\driftnet-validate-install.ps1" w
  ${If} $2 == ""
    Abort "Could not prepare the Driftnet installer validation."
  ${EndIf}
  FileWrite $2 "[CmdletBinding()]$\r$\n"
  FileWrite $2 "param($\r$\n"
  FileWrite $2 "    [Parameter(Mandatory = $$true)][string]$$InstallDirectory,$\r$\n"
  FileWrite $2 "    [ValidateSet('Validate', 'Prepare', 'Remove', 'Shortcut', 'CleanupLegacy', 'CleanupAll')][string]$$Mode = 'Prepare',$\r$\n"
  FileWrite $2 "    [string]$$ShortcutPath = '',$\r$\n"
  FileWrite $2 "    [string]$$ShortcutTarget = '',$\r$\n"
  FileWrite $2 "    [string]$$StartMenuFolder = 'Driftnet'$\r$\n"
  FileWrite $2 ")$\r$\n"
  FileWrite $2 "$$ErrorActionPreference = 'Stop'$\r$\n"
  FileWrite $2 "Set-StrictMode -Version Latest$\r$\n"
  FileWrite $2 "$$env:PSModulePath = [IO.Path]::Combine($$PSHOME, 'Modules')$\r$\n"
  FileWrite $2 "$$PSModuleAutoLoadingPreference = 'ModuleQualified'$\r$\n"
  FileWrite $2 "# Called by the elevated installer, before copying or executing any installed$\r$\n"
  FileWrite $2 "# helper. Program Files comes from the Windows known-folder API, not the caller's$\r$\n"
  FileWrite $2 "# environment. No existing executable or registry command is run here.$\r$\n"
  FileWrite $2 "$$root = [Environment]::GetFolderPath([Environment+SpecialFolder]::ProgramFiles)$\r$\n"
  FileWrite $2 "$$directory = [IO.Path]::GetFullPath($$InstallDirectory).TrimEnd('\')$\r$\n"
  FileWrite $2 "$$allowed = @([IO.Path]::Combine($$root, 'Driftnet'), [IO.Path]::Combine($$root, 'Drift'))$\r$\n"
  FileWrite $2 "if ($$directory -notin $$allowed) { throw 'Install Driftnet in its protected Program Files location.' }$\r$\n"
  FileWrite $2 "$$trusted = @('S-1-5-18', 'S-1-5-32-544', 'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464')$\r$\n"
  FileWrite $2 "function Assert-ProtectedItem([IO.FileSystemInfo]$$Item) {$\r$\n"
  FileWrite $2 "    if (($$Item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'The installation contains a reparse point. Remove the old installation before retrying.' }$\r$\n"
  FileWrite $2 "    $$acl = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $$Item.FullName$\r$\n"
  FileWrite $2 "    if ($$acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -notin $$trusted) { throw 'The installation has an unsafe owner. Remove the old installation before retrying.' }$\r$\n"
  FileWrite $2 "    foreach ($$rule in $$acl.GetAccessRules($$true, $$true, [Security.Principal.SecurityIdentifier])) {$\r$\n"
  FileWrite $2 "        if ($$rule.AccessControlType -ne 'Allow' -or ($$rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -ne 0) { continue }$\r$\n"
  FileWrite $2 "        if (([int64]$$rule.FileSystemRights -band 0x500d0156) -ne 0 -and $$rule.IdentityReference.Value -notin $$trusted) {$\r$\n"
  FileWrite $2 "            throw 'The installation is writable by an unprivileged account. Remove the old installation before retrying.'$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "    }$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileWrite $2 "function Assert-ShortcutDirectory([IO.DirectoryInfo]$$Item) {$\r$\n"
  FileWrite $2 "    # Common Start Menu/Desktop directories may permit NEW entries. Creation$\r$\n"
  FileWrite $2 "    # alone cannot replace an existing protected link. Keep all mutation,$\r$\n"
  FileWrite $2 "    # deletion, ownership, ACL, and reparse-point checks for these ancestors.$\r$\n"
  FileWrite $2 "    if (($$Item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Shortcut directory is a reparse point.' }$\r$\n"
  FileWrite $2 "    $$acl = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $$Item.FullName$\r$\n"
  FileWrite $2 "    if ($$acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -notin $$trusted) { throw 'Shortcut directory has an unsafe owner.' }$\r$\n"
  FileWrite $2 "    foreach ($$rule in $$acl.GetAccessRules($$true, $$true, [Security.Principal.SecurityIdentifier])) {$\r$\n"
  FileWrite $2 "        if ($$rule.AccessControlType -ne 'Allow' -or ($$rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -ne 0) { continue }$\r$\n"
  FileWrite $2 "        if (([int64]$$rule.FileSystemRights -band 0x500d0150) -ne 0 -and $$rule.IdentityReference.Value -notin $$trusted) {$\r$\n"
  FileWrite $2 "            throw 'Shortcut directory allows existing entries to be changed or deleted.'$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "    }$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileWrite $2 "function Test-ShortcutTarget([string]$$Path, [string]$$Target) {$\r$\n"
  FileWrite $2 "    $$shell = $$null$\r$\n"
  FileWrite $2 "    $$link = $$null$\r$\n"
  FileWrite $2 "    try {$\r$\n"
  FileWrite $2 "        $$full = [IO.Path]::GetFullPath($$Path)$\r$\n"
  FileWrite $2 "        $$expected = [IO.Path]::GetFullPath($$Target)$\r$\n"
  FileWrite $2 "        if (-not $$expected.StartsWith($$directory + '\', [StringComparison]::OrdinalIgnoreCase) -or -not [IO.File]::Exists($$full)) {$\r$\n"
  FileWrite $2 "            Microsoft.PowerShell.Utility\Write-Verbose $\"Shortcut missing or target outside installation: $$full / $$expected / $$directory$\"$\r$\n"
  FileWrite $2 "            return $$false$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "        $$commonRoots = @([Environment]::GetFolderPath('CommonPrograms'), [Environment]::GetFolderPath('CommonDesktopDirectory'))$\r$\n"
  FileWrite $2 "        $$common = $$null$\r$\n"
  FileWrite $2 "        foreach ($$candidate in $$commonRoots) {$\r$\n"
  FileWrite $2 "            if ($$full.StartsWith($$candidate + '\', [StringComparison]::OrdinalIgnoreCase)) { $$common = $$candidate; break }$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "        if ($$null -eq $$common -or [IO.Path]::GetExtension($$full) -ine '.lnk') {$\r$\n"
  FileWrite $2 "            Microsoft.PowerShell.Utility\Write-Verbose $\"Shortcut outside common folders: $$full$\"$\r$\n"
  FileWrite $2 "            return $$false$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "        # A shortcut is user-editable metadata, never executable service code.$\r$\n"
  FileWrite $2 "        # Do not require its content ACL to match Program Files. Reject leaf$\r$\n"
  FileWrite $2 "        # reparse points and retain the protected-ancestor checks below.$\r$\n"
  FileWrite $2 "        $$info = [IO.FileInfo]::new($$full)$\r$\n"
  FileWrite $2 "        if (($$info.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { return $$false }$\r$\n"
  FileWrite $2 "        if ($$VerbosePreference -eq 'Continue') {$\r$\n"
  FileWrite $2 "            $$metadataAcl = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $$full$\r$\n"
  FileWrite $2 "            foreach ($$rule in $$metadataAcl.GetAccessRules($$true, $$true, [Security.Principal.SecurityIdentifier])) {$\r$\n"
  FileWrite $2 "                Microsoft.PowerShell.Utility\Write-Verbose $\"Shortcut metadata ACL: $$full / $$($$rule.IdentityReference.Value) / $$($$rule.FileSystemRights)$\"$\r$\n"
  FileWrite $2 "            }$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "        $$parent = [IO.DirectoryInfo]::new([IO.Path]::GetDirectoryName($$full))$\r$\n"
  FileWrite $2 "        while ($$null -ne $$parent) {$\r$\n"
  FileWrite $2 "            Assert-ShortcutDirectory $$parent$\r$\n"
  FileWrite $2 "            if ([string]::Equals($$parent.FullName, $$common, [StringComparison]::OrdinalIgnoreCase)) { break }$\r$\n"
  FileWrite $2 "            $$parent = $$parent.Parent$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "        # Read metadata only. Never Save, Resolve, launch, or execute the link.$\r$\n"
  FileWrite $2 "        $$shell = [Activator]::CreateInstance([type]::GetTypeFromProgID('WScript.Shell'))$\r$\n"
  FileWrite $2 "        $$link = $$shell.CreateShortcut($$full)$\r$\n"
  FileWrite $2 "        if ([string]::IsNullOrWhiteSpace($$link.TargetPath)) { return $$false }$\r$\n"
  FileWrite $2 "        $$actual = [IO.Path]::GetFullPath([Environment]::ExpandEnvironmentVariables($$link.TargetPath))$\r$\n"
  FileWrite $2 "        $$matches = [string]::Equals($$actual, $$expected, [StringComparison]::OrdinalIgnoreCase)$\r$\n"
  FileWrite $2 "        Microsoft.PowerShell.Utility\Write-Verbose $\"Shortcut target match=$${matches}: $$actual / $$expected$\"$\r$\n"
  FileWrite $2 "        return $$matches$\r$\n"
  FileWrite $2 "    } catch {$\r$\n"
  FileWrite $2 "        Microsoft.PowerShell.Utility\Write-Verbose $\"Shortcut metadata rejected: $$($$_.Exception.Message)$\"$\r$\n"
  FileWrite $2 "        return $$false$\r$\n"
  FileWrite $2 "    }$\r$\n"
  FileWrite $2 "    finally {$\r$\n"
  FileWrite $2 "        if ($$null -ne $$link) { $$null = [Runtime.InteropServices.Marshal]::FinalReleaseComObject($$link) }$\r$\n"
  FileWrite $2 "        if ($$null -ne $$shell) { $$null = [Runtime.InteropServices.Marshal]::FinalReleaseComObject($$shell) }$\r$\n"
  FileWrite $2 "    }$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileWrite $2 "function Remove-ProductShortcuts([bool]$$All) {$\r$\n"
  FileWrite $2 "    $$programs = [Environment]::GetFolderPath('CommonPrograms')$\r$\n"
  FileWrite $2 "    $$desktop = [Environment]::GetFolderPath('CommonDesktopDirectory')$\r$\n"
  FileWrite $2 "    $$paths = @([IO.Path]::Combine($$programs, 'Drift', 'Drift.lnk'), [IO.Path]::Combine($$desktop, 'Drift.lnk'))$\r$\n"
  FileWrite $2 "    if ($$All) {$\r$\n"
  FileWrite $2 "        $$paths += @([IO.Path]::Combine($$programs, 'Driftnet', 'Driftnet.lnk'), [IO.Path]::Combine($$programs, 'Driftnet.lnk'), [IO.Path]::Combine($$desktop, 'Driftnet.lnk'))$\r$\n"
  FileWrite $2 "        if (-not [string]::IsNullOrWhiteSpace($$StartMenuFolder)) { $$paths += [IO.Path]::Combine($$programs, $$StartMenuFolder, 'Driftnet.lnk') }$\r$\n"
  FileWrite $2 "    }$\r$\n"
  FileWrite $2 "    foreach ($$path in $$paths) {$\r$\n"
  FileWrite $2 "        if (Test-ShortcutTarget $$path ([IO.Path]::Combine($$directory, 'drift-desktop.exe'))) {$\r$\n"
  FileWrite $2 "            [IO.File]::Delete($$path)$\r$\n"
  FileWrite $2 "            $$parent = [IO.Path]::GetDirectoryName($$path)$\r$\n"
  FileWrite $2 "            if (-not [string]::Equals($$parent, $$programs, [StringComparison]::OrdinalIgnoreCase) -and -not [string]::Equals($$parent, $$desktop, [StringComparison]::OrdinalIgnoreCase)) {$\r$\n"
  FileWrite $2 "                try { [IO.Directory]::Delete($$parent, $$false) } catch [IO.IOException] { }$\r$\n"
  FileWrite $2 "            }$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "    }$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileWrite $2 "# Validate ancestors before traversing children. An unsafe ancestor is rejected$\r$\n"
  FileWrite $2 "# before any descendant can be replaced, read, or executed with elevation.$\r$\n"
  FileWrite $2 "Assert-ProtectedItem (Microsoft.PowerShell.Management\Get-Item -LiteralPath $$root -Force)$\r$\n"
  FileWrite $2 "if ([IO.Directory]::Exists($$directory)) {$\r$\n"
  FileWrite $2 "    $$queue = [Collections.Generic.Queue[IO.FileSystemInfo]]::new()$\r$\n"
  FileWrite $2 "    $$queue.Enqueue((Microsoft.PowerShell.Management\Get-Item -LiteralPath $$directory -Force))$\r$\n"
  FileWrite $2 "    while ($$queue.Count -gt 0) {$\r$\n"
  FileWrite $2 "        $$item = $$queue.Dequeue()$\r$\n"
  FileWrite $2 "        Assert-ProtectedItem $$item$\r$\n"
  FileWrite $2 "        if ($$item -is [IO.DirectoryInfo]) {$\r$\n"
  FileWrite $2 "            foreach ($$child in $$item.EnumerateFileSystemInfos()) { $$queue.Enqueue($$child) }$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "    }$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileWrite $2 "if ($$Mode -eq 'Validate') { exit 0 }$\r$\n"
  FileWrite $2 "if ($$Mode -eq 'Shortcut') {$\r$\n"
  FileWrite $2 "    if (Test-ShortcutTarget $$ShortcutPath $$ShortcutTarget) { exit 0 }$\r$\n"
  FileWrite $2 "    exit 10$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileWrite $2 "if ($$Mode -eq 'CleanupLegacy' -or $$Mode -eq 'CleanupAll') {$\r$\n"
  FileWrite $2 "    Remove-ProductShortcuts ($$Mode -eq 'CleanupAll')$\r$\n"
  FileWrite $2 "    exit 0$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileWrite $2 "$$service = Microsoft.PowerShell.Management\Get-Service -Name DriftNetwork -ErrorAction SilentlyContinue$\r$\n"
  FileWrite $2 "if ($$null -ne $$service) {$\r$\n"
  FileWrite $2 "    try {$\r$\n"
  FileWrite $2 "        if ($$service.Status -ne 'Stopped') {$\r$\n"
  FileWrite $2 "            if ($$service.Status -ne 'StopPending') { $$service.Stop() }$\r$\n"
  FileWrite $2 "            $$service.WaitForStatus([ServiceProcess.ServiceControllerStatus]::Stopped, [TimeSpan]::FromSeconds(25))$\r$\n"
  FileWrite $2 "        }$\r$\n"
  FileWrite $2 "    } finally { $$service.Dispose() }$\r$\n"
  FileWrite $2 "    $$null = & ([IO.Path]::Combine([Environment]::SystemDirectory, 'sc.exe')) delete DriftNetwork$\r$\n"
  FileWrite $2 "    if ($$LASTEXITCODE -ne 0) { throw 'The networking service could not be removed.' }$\r$\n"
  FileWrite $2 "    Microsoft.PowerShell.Utility\Start-Sleep -Milliseconds 500$\r$\n"
  FileWrite $2 "}$\r$\n"
  FileClose $2
!macroend
